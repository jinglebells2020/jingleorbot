[Unit]
Description=TiCalc Pi Bridge — USB CDC server for TI-84 CE
# time-sync.target: Pi Zero has no RTC; without it, system clock is at
# the epoch on boot and TLS to api.anthropic.com fails ("not yet valid")
Wants=network-online.target ticalc-gadget.service time-sync.target
After=network-online.target ticalc-gadget.service time-sync.target
# Restart with a small backoff window so a crash loop doesn't mask itself
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
# Plain Type=simple. We previously used Type=notify with WatchdogSec
# but the watchdog ping kept failing silently and killing healthy
# bridges mid-request. Reliability of the watchdog is worse than
# without it on this platform.
Type=simple
EnvironmentFile=/etc/ticalc.env
ExecStart=/opt/ticalc/venv/bin/python /opt/ticalc/bridge.py
WorkingDirectory=/opt/ticalc
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
# Pi Zero 2 W has 512MB. Picamera2 + 4608x2592 DMA buffers + httpx
# streaming + anthropic SDK can easily push past 300M during a photo
# request. Cap at 400M to leave the kernel breathing room.
MemoryMax=400M

[Install]
WantedBy=multi-user.target
